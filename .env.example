APP_NAME=ColdForge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mail.digitelly.net
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MariaDB
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coldforge
DB_USERNAME=coldforge_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Shared Redis on the VPS: use DB index 2 + a key prefix so nothing collides with other apps
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=2
REDIS_CACHE_DB=2
REDIS_PREFIX=coldforge_

# Application framework mail only. ColdForge delivery uses the encrypted Mailbox settings screen.
MAIL_MAILER=log

# --- ColdForge ---
# Login email for the first user created by `php artisan db:seed`
ADMIN_EMAIL=admin@digitelly.net
COLDFORGE_DAILY_CAP=50
# Hostinger SMTP/IMAP credentials, allowance, physical address, signatures, and
# tracking controls are configured in Settings → Mailbox and encrypted at rest.
# ColdForge Intelligence uses the authenticated Codex CLI on the application host.
CODEX_BINARY=/home/u105894521/.local/bin/codex
CODEX_HOME=/home/u105894521/.codex
CODEX_AUTH_FILE=/home/u105894521/.codex/auth.json
CODEX_MODEL=gpt-6.2-sol
CODEX_TIMEOUT=55

# Attachment scanning is fail-closed. Install ClamAV and point to clamdscan/clamdscan.exe.
CLAMAV_BINARY=
ATTACHMENT_SCAN_BYPASS=false

# Retention windows used by the daily mail:prune-data task. Set 0 to retain indefinitely.
RETENTION_MESSAGE_BODIES_DAYS=365
RETENTION_ACTIVITY_DAYS=180
RETENTION_SYNC_LOGS_DAYS=90
RETENTION_AI_HISTORY_DAYS=180
RETENTION_ATTACHMENTS_DAYS=90
