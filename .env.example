APP_NAME=ColdForge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mail.digitelly.net
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MariaDB
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coldforge
DB_USERNAME=coldforge_user
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Shared Redis on the VPS: use DB index 2 + a key prefix so nothing collides with other apps
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=2
REDIS_CACHE_DB=2
REDIS_PREFIX=coldforge_

# Not used for campaigns (those go through Settings → Senders), only for Laravel's own mail.
MAIL_MAILER=log

# --- ColdForge ---
# Used by any Brevo sender whose own API key is left blank (the seeded one is).
BREVO_API_KEY=
# Login email for the first user created by `php artisan db:seed`
ADMIN_EMAIL=admin@digitelly.net
COLDFORGE_DAILY_CAP=50
COLDFORGE_SENDER_TPS=10
# Postal address in the unsubscribe footer (required by CAN-SPAM). Optional.
COLDFORGE_FOOTER_ADDRESS=
# Groq API key (free tier) for the "Auto-suggest industries" LLM clusterer.
# When blank, the suggester falls back to the keyword-greedy heuristic.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Random path secret for the Brevo webhook URL. Brevo does not sign webhooks,
# so the secret in the URL path is the auth. Generate via:
#   php -r "echo bin2hex(random_bytes(24));"
BREVO_WEBHOOK_SECRET=
# Same for Hostinger Agentic Mail inbox webhook.
HOSTINGER_MAIL_WEBHOOK_SECRET=
# The "Secret key" Hostinger shows once when you add the webhook (sent as a Bearer token).
HOSTINGER_MAIL_WEBHOOK_TOKEN=
